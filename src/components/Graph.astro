---
interface NodeIn {
  id: string;
  label: string;
  weight: number;
}
interface EdgeIn {
  source: string;
  target: string;
  weight?: number;
  sharedTags?: string[];
}

interface Props {
  nodes: NodeIn[];
  edges: EdgeIn[];
  id?: string;
  height?: number;
  emptyMessage?: string;
  /** How aggressively to truncate displayed labels. Long titles will be ellipsised. */
  labelMaxChars?: number;
}

const {
  nodes,
  edges,
  id = 'graph',
  height = 460,
  emptyMessage = 'Not enough data yet, the graph will fill in as more sessions are added.',
  labelMaxChars = 28,
} = Astro.props;

function ellipsise(s: string, n: number): string {
  if (s.length <= n) return s;
  return s.slice(0, n - 1).trimEnd() + '…';
}

const isEmpty = nodes.length === 0;
const elements = [
  ...nodes.map((n) => ({
    data: {
      id: n.id,
      label: ellipsise(n.label, labelMaxChars),
      fullLabel: n.label,
      weight: n.weight,
    },
  })),
  ...edges.map((e) => ({
    data: {
      id: `${e.source}-${e.target}`,
      source: e.source,
      target: e.target,
      weight: e.weight ?? 1,
      sharedTags: e.sharedTags ?? [],
    },
  })),
];
const json = JSON.stringify(elements);
---

{isEmpty ? (
  <div class="graph" style={`height:${height}px;display:flex;align-items:center;justify-content:center;`}>
    <p class="dim" style="text-align:center;max-width:24rem;">{emptyMessage}</p>
  </div>
) : (
  <div id={id} class="graph" style={`height:${height}px;`} data-elements={json}></div>
)}

<script>
  import cytoscape from 'cytoscape';

  function init() {
    document.querySelectorAll<HTMLElement>('.graph[data-elements]').forEach((el) => {
      if (el.dataset.initialized) return;
      el.dataset.initialized = '1';
      const raw = el.dataset.elements;
      if (!raw) return;
      const elements = JSON.parse(raw);
      const nodeCount = elements.filter((e: any) => !e.data.source).length;
      // Small graphs (the papers web) get the circle layout and large,
      // uniform nodes and labels. The threshold is generous so the papers
      // graph stays in this mode as the group reads more.
      const small = nodeCount <= 15;

      // Pick a layout that suits the data density.
      // - small graphs (<= 15 nodes): even circle, predictable spacing
      // - medium graphs: cose, lets edges pull related nodes together
      // - large graphs (> 25 nodes): concentric, hubs in the center
      const SMALL_FONT = 22;
      let layout: any;
      if (small) {
        // Labels sit above their node (Cytoscape's default). Non-default
        // alignments have a bounding-box bug that clips the text, so we
        // avoid them and instead size the circle so that the two labels
        // flanking the top node can't overlap. Their horizontal gap is
        // 2R·sin(2π/n), so R is derived from the widest label. Sized
        // this way the graph stays close to zoom 1 and fit() doesn't
        // shrink the labels into illegibility.
        const ctx = document.createElement('canvas').getContext('2d')!;
        ctx.font = `500 ${SMALL_FONT}px Inter, sans-serif`;
        const maxLabelW = Math.max(
          ...elements.filter((e: any) => !e.data.source).map((e: any) => ctx.measureText(e.data.label).width),
        );
        const gap = 24;
        const radius = Math.max(150, (maxLabelW + gap) / (2 * Math.sin((2 * Math.PI) / nodeCount)));
        layout = {
          name: 'circle',
          animate: false,
          padding: 40,
          radius,
        };
      } else if (nodeCount > 25) {
        // Band weights on a log2 scale so each ring holds a tier of
        // similar importance: {1}, {2-3}, {4-7}, {8-15}, ... Banding on
        // raw weight put each of the top hubs on its own one-node ring,
        // which stacked them in a vertical line through the centre.
        layout = {
          name: 'concentric',
          animate: false,
          padding: 40,
          minNodeSpacing: 50,
          concentric: (n: any) => Math.ceil(Math.log2((n.data('weight') || 1) + 1)),
          levelWidth: () => 1,
          spacingFactor: 1.1,
        };
      } else {
        layout = {
          name: 'cose',
          animate: false,
          padding: 60,
          idealEdgeLength: () => 160,
          nodeRepulsion: () => 32000,
          gravity: 0.15,
          numIter: 1500,
          nodeOverlap: 40,
          componentSpacing: 100,
        };
      }

      const cy = cytoscape({
        container: el,
        elements,
        style: [
          {
            selector: 'node',
            style: {
              'background-color': '#1a1714',
              label: 'data(label)',
              // Make the label text itself hoverable and clickable, not
              // just the dot. Cytoscape defaults this to 'no'.
              'text-events': 'yes',
              color: '#3a322a',
              'font-family': 'Inter, sans-serif',
              'font-size': small ? SMALL_FONT : 16,
              'font-weight': 500,
              'text-margin-y': -12,
              'text-valign': 'top',
              'text-halign': 'center',
              'text-background-opacity': 0,
              width: small ? 18 : 'mapData(weight, 1, 8, 12, 34)',
              height: small ? 18 : 'mapData(weight, 1, 8, 12, 34)',
              'border-width': 1,
              'border-color': '#d9c49e',
            },
          },
          {
            selector: 'node:active',
            style: {
              'overlay-color': '#a65e2e',
              'overlay-opacity': 0.2,
            },
          },
          {
            selector: 'edge',
            style: {
              width: 'mapData(weight, 1, 6, 1.6, 3.6)',
              'line-color': '#a65e2e',
              'curve-style': 'straight',
              opacity: 0.45,
              'font-family': 'Inter, sans-serif',
              'font-size': 16,
              'font-weight': 600,
              color: '#1a1714',
              'text-background-color': '#fbfaf4',
              'text-background-opacity': 1,
              'text-background-padding': 8,
              'text-background-shape': 'roundrectangle',
              'text-border-color': '#a65e2e',
              'text-border-opacity': 0.6,
              'text-border-width': 1,
            },
          },
          // Hover states. On node hover, the hovered node and its
          // neighbourhood get .hot and everything else gets .faded, so
          // you can see what a concept co-occurs with.
          {
            selector: '.faded',
            style: { opacity: 0.12 },
          },
          {
            selector: 'node.hot',
            style: {
              'background-color': '#a65e2e',
              'border-color': '#a65e2e',
              color: '#1a1714',
              'font-weight': 600,
              'z-index': 999,
            },
          },
          {
            selector: 'edge.hot',
            style: {
              'line-color': '#7e441f',
              opacity: 0.9,
              width: 'mapData(weight, 1, 6, 2.5, 4.5)',
              'z-index': 998,
            },
          },
        ],
        layout,
        wheelSensitivity: 0.2,
        minZoom: 0.4,
        maxZoom: 2.5,
        userZoomingEnabled: false,
        userPanningEnabled: false,
      });

      // Keep the graph fitted as the container is sized. Labels scale with
      // zoom, so cap it at 1: a graph that fits with room to spare should
      // render at its true style sizes, not be inflated to fill the box.
      const fit = () => {
        cy.fit(undefined, 60);
        if (cy.zoom() > 1) {
          cy.zoom(1);
          cy.center();
        }
      };
      fit();
      const ro = new ResizeObserver(fit);
      ro.observe(el);

      // A node is clickable only if the page has a link for it (the
      // papers list renders one per paper; concept tags have none).
      const linkFor = (id: string) =>
        document.querySelector<HTMLAnchorElement>(`a[data-paper-slug="${id}"]`);

      cy.on('mouseover', 'node', (e) => {
        const n = e.target;
        const hood = n.closedNeighborhood();
        cy.elements().not(hood).addClass('faded');
        hood.addClass('hot');
        n.style({ label: n.data('fullLabel') });
        el.style.cursor = linkFor(n.id()) ? 'pointer' : 'default';
      });
      cy.on('mouseout', 'node', (e) => {
        cy.elements().removeClass('faded hot');
        e.target.removeStyle();
        el.style.cursor = '';
      });
      cy.on('tap', 'node', (e) => {
        const link = linkFor(e.target.id());
        if (link?.href) window.location.href = link.href;
      });

      // Edge hover: the papers graph shows the tags two papers share; the
      // concept graph shows how many times two concepts co-occurred.
      cy.on('mouseover', 'edge', (e) => {
        const edge = e.target;
        const tags = edge.data('sharedTags') as string[] | undefined;
        const w = edge.data('weight') || 1;
        const label =
          tags && tags.length > 0
            ? tags.join('  ·  ')
            : `${w} co-occurrence${w === 1 ? '' : 's'}`;
        edge.addClass('hot');
        edge.style({
          label,
          'text-background-opacity': 1,
          'text-border-opacity': 1,
        });
      });
      cy.on('mouseout', 'edge', (e) => {
        e.target.removeClass('hot');
        e.target.removeStyle();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
