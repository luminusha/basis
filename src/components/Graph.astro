---
interface NodeIn {
  id: string;
  label: string;
  weight: number;
}
interface EdgeIn {
  source: string;
  target: string;
  weight?: number;
  sharedTags?: string[];
}

interface Props {
  nodes: NodeIn[];
  edges: EdgeIn[];
  id?: string;
  height?: number;
  emptyMessage?: string;
  /** How aggressively to truncate displayed labels. Long titles will be ellipsised. */
  labelMaxChars?: number;
}

const {
  nodes,
  edges,
  id = 'graph',
  height = 460,
  emptyMessage = 'Not enough data yet, the graph will fill in as more sessions are added.',
  labelMaxChars = 28,
} = Astro.props;

function ellipsise(s: string, n: number): string {
  if (s.length <= n) return s;
  return s.slice(0, n - 1).trimEnd() + '…';
}

const isEmpty = nodes.length === 0;
const elements = [
  ...nodes.map((n) => ({
    data: {
      id: n.id,
      label: ellipsise(n.label, labelMaxChars),
      fullLabel: n.label,
      weight: n.weight,
    },
  })),
  ...edges.map((e) => ({
    data: {
      id: `${e.source}-${e.target}`,
      source: e.source,
      target: e.target,
      weight: e.weight ?? 1,
      sharedTags: e.sharedTags ?? [],
    },
  })),
];
const json = JSON.stringify(elements);
---

{isEmpty ? (
  <div class="graph" style={`height:${height}px;display:flex;align-items:center;justify-content:center;`}>
    <p class="dim" style="text-align:center;max-width:24rem;">{emptyMessage}</p>
  </div>
) : (
  <div id={id} class="graph" style={`height:${height}px;`} data-elements={json}></div>
)}

<script>
  import cytoscape from 'cytoscape';

  function init() {
    document.querySelectorAll<HTMLElement>('.graph[data-elements]').forEach((el) => {
      if (el.dataset.initialized) return;
      el.dataset.initialized = '1';
      const raw = el.dataset.elements;
      if (!raw) return;
      const elements = JSON.parse(raw);
      const nodeCount = elements.filter((e: any) => !e.data.source).length;
      // Small graphs (the papers web) get the circle layout and large,
      // uniform nodes and labels. The threshold is generous so the papers
      // graph stays in this mode as the group reads more.
      const small = nodeCount <= 15;

      // Pick a layout that suits the data density.
      // - small graphs (<= 15 nodes): even circle, predictable spacing
      // - medium graphs: cose, lets edges pull related nodes together
      // - large graphs (> 25 nodes): concentric, hubs in the center
      let layout: any;
      if (small) {
        // Explicit, compact radius. If the circle is sized from the
        // container, the labels push the bounding box well past it and
        // fit() zooms everything down to ~0.45, which is what makes the
        // labels unreadable. A tight circle lets fit() stay near zoom 1.
        layout = {
          name: 'circle',
          animate: false,
          padding: 40,
          radius: Math.min(el.clientWidth, el.clientHeight) * 0.27,
        };
      } else if (nodeCount > 25) {
        layout = {
          name: 'concentric',
          animate: false,
          padding: 40,
          minNodeSpacing: 28,
          concentric: (n: any) => n.data('weight') || 1,
          levelWidth: () => 2,
          spacingFactor: 1.1,
        };
      } else {
        layout = {
          name: 'cose',
          animate: false,
          padding: 60,
          idealEdgeLength: () => 160,
          nodeRepulsion: () => 32000,
          gravity: 0.15,
          numIter: 1500,
          nodeOverlap: 40,
          componentSpacing: 100,
        };
      }

      const cy = cytoscape({
        container: el,
        elements,
        style: [
          {
            selector: 'node',
            style: {
              'background-color': '#1a1714',
              label: 'data(label)',
              // Make the label text itself hoverable and clickable, not
              // just the dot. Cytoscape defaults this to 'no'.
              'text-events': 'yes',
              color: '#3a322a',
              'font-family': 'Inter, sans-serif',
              'font-size': small ? 22 : 16,
              'font-weight': 500,
              'text-margin-y': -16,
              'text-valign': 'top',
              'text-halign': 'center',
              'text-background-opacity': 0,
              width: small ? 18 : 'mapData(weight, 1, 8, 12, 34)',
              height: small ? 18 : 'mapData(weight, 1, 8, 12, 34)',
              'border-width': 1,
              'border-color': '#d9c49e',
            },
          },
          {
            // Radial label placement for the circle layout: set as data so
            // it lives in the stylesheet and survives removeStyle() on hover.
            selector: 'node[halign]',
            style: {
              'text-halign': 'data(halign)',
              'text-valign': 'data(valign)',
              'text-margin-x': 'data(mx)',
              'text-margin-y': 'data(my)',
            },
          },
          {
            selector: 'node:active',
            style: {
              'overlay-color': '#a65e2e',
              'overlay-opacity': 0.2,
            },
          },
          {
            selector: 'edge',
            style: {
              width: 'mapData(weight, 1, 6, 1.6, 3.6)',
              'line-color': '#a65e2e',
              'curve-style': 'straight',
              opacity: 0.45,
              'font-family': 'Inter, sans-serif',
              'font-size': 16,
              'font-weight': 600,
              color: '#1a1714',
              'text-background-color': '#fbfaf4',
              'text-background-opacity': 1,
              'text-background-padding': 8,
              'text-background-shape': 'roundrectangle',
              'text-border-color': '#a65e2e',
              'text-border-opacity': 0.6,
              'text-border-width': 1,
            },
          },
        ],
        layout,
        wheelSensitivity: 0.2,
        minZoom: 0.4,
        maxZoom: 2.5,
        userZoomingEnabled: false,
        userPanningEnabled: false,
      });

      // On the circle layout, point each label away from the centre so
      // neighbours don't stack on top of each other. Nodes on the left
      // get their label to the left, top nodes above, and so on.
      if (small) {
        const bb = cy.nodes().boundingBox();
        const cx = (bb.x1 + bb.x2) / 2;
        const cyy = (bb.y1 + bb.y2) / 2;
        const eps = Math.max(bb.w, bb.h) * 0.12;
        const gap = 10;
        cy.nodes().forEach((n) => {
          const { x, y } = n.position();
          const dx = x - cx;
          const dy = y - cyy;
          const halign = dx < -eps ? 'left' : dx > eps ? 'right' : 'center';
          const valign = dy < -eps ? 'top' : dy > eps ? 'bottom' : 'center';
          n.data({
            halign,
            valign,
            mx: halign === 'left' ? -gap : halign === 'right' ? gap : 0,
            my: valign === 'top' ? -gap : valign === 'bottom' ? gap : 0,
          });
        });
      }

      // Keep the graph fitted as the container is sized. Labels scale with
      // zoom, so cap it at 1: a graph that fits with room to spare should
      // render at its true style sizes, not be inflated to fill the box.
      const fit = () => {
        cy.fit(undefined, 60);
        if (cy.zoom() > 1) {
          cy.zoom(1);
          cy.center();
        }
      };
      fit();
      const ro = new ResizeObserver(fit);
      ro.observe(el);

      cy.on('mouseover', 'node', (e) => {
        e.target.style({
          'background-color': '#a65e2e',
          'border-color': '#a65e2e',
          color: '#1a1714',
          'font-weight': 600,
          label: e.target.data('fullLabel'),
          'z-index': 999,
        });
        el.style.cursor = 'pointer';
      });
      cy.on('mouseout', 'node', (e) => {
        e.target.removeStyle();
        el.style.cursor = '';
      });
      cy.on('tap', 'node', (e) => {
        const id = e.target.id();
        const link = document.querySelector<HTMLAnchorElement>(`a[data-paper-slug="${id}"]`);
        if (link?.href) window.location.href = link.href;
      });

      cy.on('mouseover', 'edge', (e) => {
        const tags = e.target.data('sharedTags') as string[] | undefined;
        if (!tags || tags.length === 0) return;
        e.target.style({
          label: tags.join('  ·  '),
          'line-color': '#7e441f',
          opacity: 0.9,
          'text-background-opacity': 1,
          'text-border-opacity': 1,
          width: 'mapData(weight, 1, 6, 2.5, 4.5)',
          'z-index': 998,
        });
      });
      cy.on('mouseout', 'edge', (e) => {
        e.target.removeStyle();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
